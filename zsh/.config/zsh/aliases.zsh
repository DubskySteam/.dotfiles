alias home="cd ~"
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."

alias ls="eza --all --color=always --group-directories-first --icons"
alias ll="eza -l --all --color=always --group-directories-first --icons --git"
alias tree="eza --tree --all --color=always --icons"

alias cat="bat"
alias vim="nvim"
alias lg="lazygit"
alias g="git"
alias cdg="cd ~/.dotfiles"
alias cdc="cd ~/code"

alias ta="tmux attach -t"
alias tn="tmux new-session -s"
alias tl="tmux list-sessions"

alias update="paru -Syu"
alias c="clear"
alias cls="clear"
