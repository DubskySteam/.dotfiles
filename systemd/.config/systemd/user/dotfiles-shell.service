[Unit]
Description=Active dotfiles shell profile
Documentation=https://github.com/DubskySteam/.dotfiles
PartOf=graphical-session.target
After=graphical-session.target
Conflicts=waybar.service

[Service]
Type=simple
ExecStart=%h/.local/bin/dotfiles-profile run
Restart=on-failure
RestartSec=2
Environment=QT_QPA_PLATFORM=wayland

[Install]
WantedBy=graphical-session.target
